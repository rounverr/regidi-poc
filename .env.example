# Node loopback development. Use a fresh issuer key generated by npm run --silent keygen.
NODE_ENV=development
REGIDI_CHALLENGE=development
REGIDI_HOST=127.0.0.1
REGIDI_PORT=8787
REGIDI_SQLITE_PATH=./regidi-lab.sqlite
ISSUER_PRIVATE_JWK=

# Set the public HTTPS origin when hosting. The Workers build uses it for routing and Siteverify.
# REGIDI_PUBLIC_ORIGIN=https://lab.example.com
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Optional logical identifiers. The two audiences must be distinct.
# REGIDI_ISSUER=urn:regidi:lab:issuer
# REGIDI_AIR_AUDIENCE=urn:regidi:lab:aero
# REGIDI_BANK_AUDIENCE=urn:regidi:lab:bank

# Optional Cloudflare target. Set explicit values only for a target you control.
# CLOUDFLARE_ACCOUNT_ID=
# REGIDI_WORKER_NAME=
# REGIDI_D1_NAME=
# REGIDI_D1_ID=
# REGIDI_RATE_NAMESPACE=
