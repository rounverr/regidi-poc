{
  "name": "regidi-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "start": "node --env-file-if-exists=.env src/node/index.ts",
    "build": "astro build",
    "check": "astro check && tsc -p tsconfig.node.json",
    "dev:cloudflare": "npm run build && vite dev",
    "build:cloudflare": "npm run build && vite build",
    "check:cloudflare": "cf workers types --no-include-runtime && tsc -p tsconfig.worker.json",
    "test": "npm run build:cloudflare && node --test tests/*.test.mjs",
    "test:node": "npm run build && node --test tests/node.test.mjs tests/ui.test.mjs",
    "deploy:check": "node --env-file-if-exists=.env scripts/deploy.mjs --check",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.mjs",
    "db:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --local --dir migrations",
    "keygen": "node scripts/generate-key.mjs",
    "audit:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "astro": "7.4.13",
    "hono": "4.13.19",
    "jose": "6.2.18",
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/vite-plugin": "2.0.0-rc.3",
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cf": "1.0.0-rc.2",
    "miniflare": "5.20261117.0-beta",
    "typescript": "^6.0.0",
    "vite": "8.3.8"
  }
}
